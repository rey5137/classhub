# Copy to .env.cloudflare (gitignored) and fill in. Every remote Cloudflare command reads this file
# through scripts/cf.mjs (docs/spec/platform/02-platform-repo.md §2.6), never your global `wrangler login`.

# The Cloudflare account this deployment lives in (Dashboard → Account home → Account ID).
CLOUDFLARE_ACCOUNT_ID=

# An account-scoped API token for that account (My Profile → API Tokens → Create Token → Custom):
#   Account · Workers Scripts · Edit
#   Account · D1 · Edit
#   Account · Workers R2 Storage · Edit
#   Account · Account Settings · Read
#   Account · Access: Apps and Policies · Edit   (optional: lets `npm run invite` sync the Access allowlist)
CLOUDFLARE_API_TOKEN=

# Filled after creating the Access application (docs/GOOGLE_ACCESS.md, step 7).
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Optional, for `npm run invite` to sync the Allow policy's email list (R-AUTH-18): the policy id
# (Zero Trust → Access → Policies, or the application's Policies tab) and, for a policy that belongs
# to one application, that application's id. Without them invite prints the dashboard step.
ACCESS_POLICY_ID=
ACCESS_APP_ID=

# R2 S3 credentials for backups (Dashboard → R2 → Manage API tokens → Object Read only, scoped to the bucket).
# Used only by scripts/lib/s3.mjs (R-BAK-17); the endpoint comes from CLOUDFLARE_ACCOUNT_ID.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public `age` recipient (age1...) that encrypts every backup and chat archive (R-BAK-05). Keep the identity key elsewhere.
AGE_RECIPIENT=
