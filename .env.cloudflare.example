# Copy to .env.cloudflare (gitignored) and fill in. Every remote Cloudflare command reads this file
# through scripts/cf.mjs (docs/spec/platform/02-platform-repo.md §2.6), never your global `wrangler login`.

# The Cloudflare account this deployment lives in (Dashboard → Account home → Account ID).
CLOUDFLARE_ACCOUNT_ID=

# An account-scoped API token for that account (My Profile → API Tokens → Create Token → Custom):
#   Account · Workers Scripts · Edit
#   Account · D1 · Edit
#   Account · Workers R2 Storage · Edit
#   Account · Account Settings · Read
#   Account · Access: Apps and Policies · Edit   (optional: lets `npm run invite` sync the Access allowlist)
CLOUDFLARE_API_TOKEN=

# Filled after creating the Access application (docs/GOOGLE_ACCESS.md, step 7).
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
