{
  "name": "classhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:offline": "CLASSHUB_OFFLINE=1 vite dev --host 127.0.0.1",
    "build": "vite build",
    "build:worker-check": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.wrangler/dry-run', { recursive: true, force: true })\" && node scripts/cf.mjs deploy --dry-run --outdir .wrangler/dry-run && node scripts/check-worker-exports.mjs .wrangler/dry-run",
    "preview": "vite preview",
    "lint": "prettier --check . && eslint . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.svelte\"",
    "format": "prettier --write .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "verify": "npm run lint && npm run check && npm run test && npm run test:migrations && npm run test:security && npm run build && npm run build:worker-check",
    "deploy": "node scripts/cf.mjs --check-deploy && npm run build && npm run build:worker-check && node scripts/cf.mjs deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^18.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
