{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classhub",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classhub-db",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "classhub-media" }],
  "services": [{ "binding": "PUSH", "service": "classhub", "entrypoint": "PushDelivery" }],
  "durable_objects": { "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }]
}
